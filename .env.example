# Laravel Reverb — WebSocket server (run: php artisan reverb:start)
# Port 8180 avoids conflict with the remix Vite dev server (8080)
REVERB_APP_ID=workflow-local
REVERB_APP_KEY=workflow-local-key
REVERB_APP_SECRET=workflow-local-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8180
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

