APP_NAME="Workflow Automation Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (PostgreSQL container)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=workflow_automation
DB_USERNAME=workflow_user
DB_PASSWORD=workflow_secret

# Session, Cache & Queue using Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Real-time WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=workflow-local
REVERB_APP_KEY=workflow-local-key
REVERB_APP_SECRET=workflow-local-secret
REVERB_HOST=localhost
REVERB_PORT=8180
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

# Frontend Reverb Connection
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8180
VITE_REVERB_SCHEME=http

# File Storage
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Authentication
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160

# External Integrations (Optional)
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_TIMEOUT=60
RAG_SERVICE_API_KEY=
CLICKUP_CLIENT_ID=
