    "item": [
        {
            "name": "Auth",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (pm.response.code === 200 && pm.response.headers.get(\"content-type\")?.includes(\"application/json\")) {",
                            "    try {",
                            "        const jsonData = pm.response.json();",
                            "        ",
                            "        // 🔍 عدّل المسار حسب هيكل الرد الفعلي لـ API الخاص بك",
                            "        const token = jsonData.token || ",
                            "                      jsonData.access_token || ",
                            "                      jsonData.data?.token || ",
                            "                      jsonData.result?.access_token;",
                            "",
                            "        if (token) {",
                            "            // ✅ الحفظ في البيئة النشطة فقط",
                            "            pm.environment.set(\"token\", token);",
                            "            console.log(\"✅ تم حفظ التوكن في Environment:\", pm.environment.name);",
                            "        } else {",
                            "            console.warn(\"⚠️ لم يُعثر على حقل التوكن. تحقق من هيكل الـ JSON.\");",
                            "        }",
                            "    } catch (error) {",
                            "        console.error(\"❌ فشل تحليل الرد:\", error.message);",
                            "    }",
                            "} else {",
                            "    console.warn(\"⚠️ الرد غير ناجح أو ليس بصيغة JSON. لم يتم حفظ التوكن.\");",
                            "}"
                        ]
                    }
                }
            ],
