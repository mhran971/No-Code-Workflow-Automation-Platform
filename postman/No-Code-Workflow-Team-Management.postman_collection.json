        "name": "No-Code Workflow Automation Platform - Team Management",
        "description": "Collection for team workflow where manager is selected from existing tenant users during team creation (no standalone manager-create API). Uses only {{base_url}} and {{token}} variables.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
